# Kong proxy base (no trailing slash), e.g. http://localhost:8000
VITE_API_GATEWAY_URL=http://localhost:8000

# Kong consumer API key (if key-auth plugin is enabled)
VITE_KONG_API_KEY=

# Razorpay Checkout key id (public) for payment step
VITE_RAZORPAY_KEY_ID=

# Display currency for Intl formatting
VITE_DEFAULT_CURRENCY=INR

# Optional: comma-separated admin emails for dashboard access
VITE_ADMIN_EMAILS=
